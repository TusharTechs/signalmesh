NODE_ID=node-a
HTTP_PORT=8080

NATS_URL=nats://localhost:4222

# Optional local fallback. If set and reachable, the local-fallback provider
# calls Ollama; otherwise it returns a deterministic static answer.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Provisioned in docker-compose for the intended durable-audit / shared-state
# design. NOT on the request path in this prototype (state is in-memory).
# POSTGRES_URL=postgres://signalmesh:signalmesh@localhost:5432/signalmesh?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# Real provider connectors are future work (see README "What is real").
# A `Provider` implementation would read its own key here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
